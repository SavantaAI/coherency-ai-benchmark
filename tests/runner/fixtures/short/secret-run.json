{
 "format": "cohbench-scripted-run",
 "version": 1,
 "probes": {},
 "script": {
  "version": 1,
  "description": "A secret request refused with the task's text, as in the driver's test of refuse_secret.",
  "handlers": [
   {
    "id": "ask",
    "on_steer": "abandon",
    "steps": [
     {
      "do": "tool",
      "name": "tool_search",
      "input": {
       "query": "request_secret",
       "limit": 5
      }
     },
     {
      "do": "tool",
      "name": "mcp__t3-code__request_secret",
      "input": {
       "label": "Deploy key",
       "reason": "To push the release.",
       "delivery": "file",
       "fields": [
        {
         "name": "key",
         "label": "Key"
        }
       ]
      }
     },
     {
      "do": "bash",
      "command": "sleep 5; echo waited",
      "delay": 2
     }
    ],
    "final": "carried on"
   },
   {
    "id": "after_refusal",
    "expect": {
     "contains": "can't share credentials"
    },
    "steps": [],
    "final": "Understood, I will publish without the key."
   },
   {
    "id": "post_run",
    "expect": {
     "contains": "Before you go"
    },
    "steps": [],
    "final": "Nothing seemed unusual."
   }
  ]
 }
}
